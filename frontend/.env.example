# ---------------------------------------------------------------------------
# TuneIt Frontend — environment template
# Copy to `.env.local` for local development.
# These are NEXT_PUBLIC_*, so they are embedded in the browser bundle.
# Never put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the TuneIt backend API.
# Local:      http://127.0.0.1:3001
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Without a custom domain (app on *.vercel.app, API on *.onrender.com), set
# NEXT_PUBLIC_API_URL=/ and point this at the backend. /api and /auth on this
# app are then passed through to it, so the session cookie is first-party and
# sign-in works in Safari and Firefox. Server-side only; not in the bundle.
# BACKEND_ORIGIN=https://tuneit-api.onrender.com

# Public URL this frontend is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console "HTML tag" verification code (just the content value).
# Google's OAuth verification asks you to prove you control the home page's
# address; this adds <meta name="google-site-verification"> to every page.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
