# ---------------------------------------------------------------------------
# TuneIt Backend — environment template
# Copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3001

# Where the browser app is served from. Used for CORS and post-login redirects.
FRONTEND_URL=http://127.0.0.1:3000

# Extra browser origins allowed to call this API (comma separated).
# Useful for preview deployments, e.g. https://tuneit-git-dev.vercel.app
ADDITIONAL_CORS_ORIGINS=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# The redirect URI must match the Authorized redirect URI on the OAuth client
# exactly, including scheme, host, port and path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/auth/callback

# Gemini — https://aistudio.google.com/apikey
# Used for BPM / intensity analysis and track recommendations.
GEMINI_API_KEY=

# PostgreSQL connection string for the analysed-track cache.
DATABASE_URL=postgresql://user:password@localhost:5432/tuneit?schema=public

# Playlist creations allowed per session per day (YouTube write-quota guard).
DAILY_EXPORT_LIMIT=3

# Force SameSite=None; Secure on the session cookie. Set to true when the
# frontend and backend are on different domains but auto-detection misses it.
# CROSS_SITE_COOKIES=true
