generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model YoutubeTrack {
  videoId        String   @id
  title          String
  artist         String
  estimatedBpm   Int
  intensityScore Float
  lastUpdated    DateTime @default(now())

  @@map("youtube_tracks")
}
