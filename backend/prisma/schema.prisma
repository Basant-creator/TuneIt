generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model YoutubeTrack {
  trackKey       String   @id // Normalized key: "slugify(artist):::slugify(title)"
  videoId        String?  // Associated YouTube video ID (optional/latest)
  title          String
  artist         String
  estimatedBpm   Int
  intensityScore Float
  lastUpdated    DateTime @default(now())

  @@map("youtube_tracks")
}
