generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model YoutubeTrack {
  trackKey       String   @id // Normalized key: "slugify(artist):::slugify(title)"
  videoId        String?  // Associated YouTube video ID (optional/latest)
  title          String
  artist         String
  estimatedBpm   Int
  intensityScore Float
  /// Musical positivity 0.0-1.0. Null when the analyser could not determine it.
  valence        Float?
  /// Camelot wheel key, e.g. "8A". Null when genuinely unknown — the sequencing
  /// engines treat a present value as real harmonic data, so it is never guessed.
  camelotKey     String?
  lastUpdated    DateTime @default(now())

  @@map("youtube_tracks")
}
