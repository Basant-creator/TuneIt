{
  "name": "tuneit-backend",
  "version": "1.0.0",
  "description": "Backend authentication and playlist pipeline for TuneIt",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "evaluate:drift": "ts-node scripts/evaluateSequencing.ts",
    "evaluate:frame": "ts-node scripts/evaluateFrameEngine.ts",
    "evaluate:jamendo": "ts-node scripts/evaluateMTGJamendo.ts",
    "evaluate:unhinged": "ts-node scripts/evaluateUnhingedEngine.ts",
    "evaluate:rise": "ts-node scripts/evaluateRiseEngine.ts",
    "evaluate:all": "ts-node scripts/evaluateCombinedEngines.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.2",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
